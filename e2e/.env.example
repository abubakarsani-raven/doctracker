# Copy to e2e/.env for local runs.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4003

# Seeded / bootstrap users (see frontend/TEST_USERS.md)
# Master is always seeded; staff users need bootstrap-contracts-api.sh
E2E_EMAIL=aisha@example.com
E2E_PASSWORD=Password123!

# Optional second user for permission / signature flows
E2E_SIGNER_EMAIL=ibrahim@example.com
E2E_SIGNER_PASSWORD=Password123!
