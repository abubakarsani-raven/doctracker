# ---------------------------------------------------------------------------
# Frontend environment template. Copy to `.env.local` and fill in.
#   cp frontend/.env.example frontend/.env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so this must be a
# URL the *browser* can reach — not a docker-internal hostname like
# `http://backend:4003`.
# ---------------------------------------------------------------------------

# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4003

# Vercel deployment: set this to your Railway backend URL, e.g.
#   NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Authentication Notes:
# - The app now uses httpOnly cookies (dt_access, dt_refresh) for JWT tokens
# - CSRF protection via dt_csrf cookie and X-CSRF-Token header
# - All API requests include credentials: 'include' for cookie support
# - WebSocket connections use withCredentials: true for cookie-based auth
