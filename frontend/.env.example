# ---------------------------------------------------------------------------
# Frontend environment template. Copy to `.env.local` and fill in.
#   cp frontend/.env.example frontend/.env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so this must be a
# URL the *browser* can reach — not a docker-internal hostname like
# `http://backend:4003`.
# ---------------------------------------------------------------------------

# Recommended local setup (same-origin rewrite → Nest on :4003):
# Avoids cross-origin cookie / CORP failures in Chrome.
NEXT_PUBLIC_API_URL=/api-backend
BACKEND_URL=http://localhost:4003
NEXT_PUBLIC_WS_URL=http://localhost:4003

# Alternative: talk to Nest directly (cross-origin; cookies may not attach):
# NEXT_PUBLIC_API_URL=http://localhost:4003

# Vercel production (same-origin proxy → Railway):
# Browser calls /api-backend/* on the Vercel host so auth cookies are
# first-party (required for Safari). next.config.ts rewrites that path to
# BACKEND_URL.
#
#   BACKEND_URL=https://your-backend.up.railway.app
#   NEXT_PUBLIC_API_URL=/api-backend
#   NEXT_PUBLIC_WS_URL=https://your-backend.up.railway.app
#
# BACKEND_URL is server-only (used by Next rewrites). WebSocket cannot use
# HTTP rewrites, so NEXT_PUBLIC_WS_URL must be the absolute Railway host.

# Authentication Notes:
# - httpOnly cookies (dt_access, dt_refresh) for JWT; CSRF via dt_csrf + header
# - All API requests include credentials: 'include'
# - On Vercel, cookies bind to the frontend host via /api-backend rewrite
# - access_token is also kept for WebSocket handshake (WS hits Railway directly)
# - CSRF token from login/refresh JSON is stored as a fallback when the cookie
#   is not yet readable
