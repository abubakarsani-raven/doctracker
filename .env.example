# ---------------------------------------------------------------------------
# docker-compose settings. Copy to `.env` at the repo root.
#   cp .env.example .env
#
# This file configures the compose stack only. Application config lives in
# backend/.env and frontend/.env.local.
# ---------------------------------------------------------------------------

# Host ports. Defaults avoid 5432 and 3000, which are commonly already taken.
POSTGRES_PORT=5433
BACKEND_PORT=4003
FRONTEND_PORT=3001

# Database credentials (must match DATABASE_URL in backend/.env)
POSTGRES_USER=doctracker
POSTGRES_PASSWORD=doctracker
POSTGRES_DB=doctracker
