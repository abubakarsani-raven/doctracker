# ---------------------------------------------------------------------------
# Backend environment template. Copy to `.env` and fill in.
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Local (docker-compose maps Postgres to host port 5433):
DATABASE_URL=postgresql://doctracker:doctracker@localhost:5433/doctracker?schema=public
# Inside docker-compose this is overridden to:
#   postgresql://doctracker:doctracker@postgres:5432/doctracker?schema=public
# On Railway, DATABASE_URL is provided automatically by the Postgres plugin.

# Server --------------------------------------------------------------------
PORT=4003
NODE_ENV=development

# CORS / links --------------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS.
# In production, ONLY these origins will be allowed (no localhost defaults).
# In development, localhost:3000 and localhost:3001 are always allowed.
CORS_ORIGIN=http://localhost:3001
# Base URL used to build links inside notification emails.
FRONTEND_URL=http://localhost:3001

# Auth & Security -----------------------------------------------------------
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token expiration (short-lived, default 15 minutes)
JWT_EXPIRES_IN=15m
# How many reverse-proxy hops Express should trust when reading client IPs
# (X-Forwarded-For). Needed so rate limits are per-user, not one shared proxy IP.
# Defaults: production=1 (Railway), development=loopback.
# Examples: 1 | true | false | loopback
TRUST_PROXY=
# Cookie Configuration:
# - dt_access: httpOnly access token (15 minutes)
# - dt_refresh: httpOnly refresh token (7 days) 
# - dt_csrf: non-httpOnly CSRF token (7 days)
# Cookies use Secure flag in production, SameSite=None for cross-origin or Lax for same-origin

# Email (optional) ----------------------------------------------------------
# Leave SMTP_HOST empty to disable outbound email; the service logs instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@doctracker.local

# Object Storage -------------------------------------------------------------
# STORAGE_PROVIDER selects the backend: local | cloudinary | r2 | s3
# Default: auto-detect (Cloudinary if configured, else R2/S3, else local disk).
STORAGE_PROVIDER=

# Cloudinary (recommended for production document binaries)
# Create an API key in the Cloudinary console; uploads use resource_type=raw.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary account
CLOUDINARY_FOLDER=doctracker

# Leave R2/S3 empty to use local file storage (uploads/ directory) when
# Cloudinary is not configured.
# For Cloudflare R2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# For AWS S3 (alternative to R2):
# S3_ENDPOINT=              # optional, leave blank for standard AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1

# Seed ----------------------------------------------------------------------
# Password given to every demo user created by `npm run prisma:seed`.
SEED_PASSWORD=Password123!
